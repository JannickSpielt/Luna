<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Gemeinsamer Schlüsselbund mit der Teilen-Erweiterung (nur iPhone/iPad). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.lilith.geteilt</string>
	</array>
</dict>
</plist>
