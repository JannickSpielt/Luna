<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Wird mit den automatisch erzeugten Einträgen aus project.yml zusammengeführt. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Backup im Hintergrund: nachts am Ladekabel (processing) und kurz zwischendurch (fetch). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.lilith.backup.nacht</string>
		<string>app.lilith.backup.kurz</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
</dict>
</plist>
