<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Wird mit den automatisch erzeugten Einträgen aus project.yml zusammengeführt. -->
	<!-- Startbildschirm: Nachthimmel mit dem Luna-Mond (die App übernimmt nahtlos dasselbe Bild). -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>StartFarbe</string>
		<key>UIImageName</key>
		<string>StartMond</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Backup im Hintergrund: nachts am Ladekabel (processing) und kurz zwischendurch (fetch). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.lilith.backup.nacht</string>
		<string>app.lilith.backup.kurz</string>
		<string>app.lilith.Lilith.jetzt.*</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
		<string>audio</string>
	</array>
</dict>
</plist>
